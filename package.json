{
  "name": "patreon-api.ts",
  "version": "0.21.0",
  "description": "Typescript library for the V2 Patreon API",
  "license": "MIT",
  "author": {
    "name": "ghostrider-05",
    "email": "info@ghostrider-05.com"
  },
  "types": "./dist/index.d.cts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      },
      "require": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.cts"
      }
    }
  },
  "scripts": {
    "install-ci": "npm ci --ignore-scripts",
    "prestart": "npx tsc && node ./tsc-generated/scripts/v2/index.js",
    "build": "tsdown",
    "build:openapi": "npx tsc && node ./tsc-generated/scripts/v2/openapi/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "npx eslint \"src/**/*.ts\" \"examples/**/*.ts\"",
    "lint:globals": "npx tsc && node ./tsc-generated/scripts/v2/globals.js",
    "lint:fix": "npx eslint --fix \"src/**/*.ts\" \"examples/**/*.ts\""
  },
  "funding": "https://paypal.me/05ghostrider",
  "homepage": "https://github.com/ghostrider-05/patreon-api.ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostrider-05/patreon-api.ts.git"
  },
  "bugs": {
    "url": "https://github.com/ghostrider-05/patreon-api.ts/issues/"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "patreon",
    "patreon-api",
    "patreon-wrapper",
    "patreon-client",
    "typescript",
    "oauth",
    "webhook-server"
  ],
  "engines": {
    "node": ">=22",
    "runtime": [
      {
        "name": "node",
        "version": ">=22",
        "onFail": "warn"
      }
    ]
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "24.x",
        "onFail": "warn"
      }
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.4.10",
    "msw": "^3.0.6",
    "openapi-types": "^12.1.3",
    "publint": "^0.3.25",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "undici-types": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "undici-types": {
      "optional": true
    }
  }
}
